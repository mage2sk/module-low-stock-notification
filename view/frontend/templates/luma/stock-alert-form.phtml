<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    var uid = '<?= $escaper->escapeJs($uid) ?>';
    var productId = <?= (int)$productId ?>;
    var isLoggedIn = false;
    var allowGuests = <?= $allowGuests ? 'true' : 'false' ?>;
    var customerEmail = '';

    // Detect logged-in customer via Magento localStorage (FPC compatible)
    try {
        var sections = JSON.parse(localStorage.getItem('mage-cache-storage') || '{}');
        if (sections.customer && sections.customer.firstname) {
            isLoggedIn = true;
            customerEmail = sections.customer.email || '';
            var guestFields = document.getElementById(uid + '-guest-fields');
            var loggedMsg = document.getElementById(uid + '-logged-msg');
            var loggedEmailEl = document.getElementById(uid + '-logged-email');
            if (guestFields) {
                guestFields.style.display = 'none';
                guestFields.querySelectorAll('[required]').forEach(function(el) { el.required = false; });
            }
            if (loggedMsg && customerEmail) {
                loggedMsg.style.display = '';
                if (loggedEmailEl) loggedEmailEl.textContent = customerEmail;
            }
        }
    } catch(e) {}
    if (!isLoggedIn && !allowGuests) {
        var gf = document.getElementById(uid + '-guest-fields');
        if (gf) {
            gf.style.display = 'none';
            gf.querySelectorAll('[required]').forEach(function(el) { el.required = false; });
        }
        document.getElementById(uid + '-login-msg').style.display = '';
        document.getElementById(uid + '-btn').style.setProperty('display', 'none', 'important');
    }
    var formEl = document.getElementById(uid + '-form');
    var subscribedEl = document.getElementById(uid + '-subscribed');
    var toast = document.getElementById(uid + '-toast');
    var btn = document.getElementById(uid + '-btn');
    var form = document.getElementById(uid + '-subscribe-form');
    var unsubBtn = document.getElementById(uid + '-unsub');
    var toastTimer;
    var dialog = document.getElementById(uid + '-dialog');
    var trigger = document.getElementById(uid + '-trigger');
    var labelOff = '<?= $escaper->escapeJs(__('Notify me when back in stock')) ?>';
    var labelOn = '<?= $escaper->escapeJs(__('Back in stock alert is on')) ?>';

    function setTrigger(on) {
        if (!trigger) return;
        trigger.querySelector('span').textContent = on ? labelOn : labelOff;
        trigger.querySelector('.sa-trigger-bell').style.display = on ? 'none' : '';
        trigger.querySelector('.sa-trigger-check').style.display = on ? '' : 'none';
    }

    function focusables() {
        return Array.prototype.filter.call(
            dialog.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
            function(el) { return el.getClientRects().length > 0; }
        );
    }

    if (dialog && trigger && typeof dialog.showModal === 'function') {
        trigger.addEventListener('click', function() {
            if (dialog.open) return;
            dialog.showModal();
            trigger.setAttribute('aria-expanded', 'true');
            var items = focusables().filter(function(el) { return el.className.indexOf('sa-dialog-close') === -1; });
            var first = items.filter(function(el) { return el.tagName === 'INPUT'; })[0] || items[0];
            if (first) first.focus();
        });
        var afterClose = function() {
            trigger.setAttribute('aria-expanded', 'false');
            trigger.focus();
        };
        var closeDialog = function() {
            if (dialog.open) dialog.close();
            afterClose();
        };
        dialog.addEventListener('close', afterClose);
        dialog.addEventListener('cancel', afterClose);
        dialog.addEventListener('click', function(e) { if (e.target === dialog) closeDialog(); });
        document.getElementById(uid + '-dialog-close').addEventListener('click', closeDialog);
        dialog.addEventListener('keydown', function(e) {
            if (e.key !== 'Tab') return;
            var items = focusables();
            if (!items.length) return;
            var first = items[0];
            var last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });
    }

    function getFormKey() {
        var m = document.cookie.match(/form_key=([^;]+)/);
        if (m) return m[1];
        var el = document.querySelector('input[name="form_key"]');
        return el ? el.value : '';
    }

    function showToast(msg, type) {
        if (toastTimer) clearTimeout(toastTimer);
        toast.className = 'sa-toast visible ' + type;
        toast.querySelector('.sa-toast-msg').textContent = msg;
        toast.querySelector('.sa-toast-ok').style.display = type === 'success' ? '' : 'none';
        toast.querySelector('.sa-toast-err').style.display = type === 'error' ? '' : 'none';
        toastTimer = setTimeout(function() { toast.className = 'sa-toast'; }, 5000);
    }

    toast.querySelector('.close').addEventListener('click', function() { toast.className = 'sa-toast'; });

    if (isLoggedIn || allowGuests) {
        var statusXhr = new XMLHttpRequest();
        statusXhr.open('GET', '<?= $escaper->escapeJs($block->getStatusUrl()) ?>' + '?product_id=' + productId + '&_=' + Date.now());
        statusXhr.withCredentials = true;
        statusXhr.onload = function() {
            try {
                var statusData = JSON.parse(statusXhr.responseText);
                if (statusData.subscribed) {
                    formEl.style.display = 'none';
                    subscribedEl.style.display = '';
                    setTrigger(true);
                }
            } catch(ex) {}
        };
        statusXhr.send();
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!isLoggedIn && !allowGuests) {
            return;
        }
        var fd = new FormData();
        fd.append('product_id', productId);
        fd.append('form_key', getFormKey());
        if (!isLoggedIn) {
            var name = document.getElementById(uid + '-name');
            var email = document.getElementById(uid + '-email');
            if (name) fd.append('customer_name', name.value);
            if (email) fd.append('email', email.value);
        }
        btn.disabled = true;
        btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Subscribing...')) ?>';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?= $escaper->escapeJs($block->getSubscribeUrl()) ?>');
        xhr.withCredentials = true;
        xhr.onload = function() {
            try {
                var data = JSON.parse(xhr.responseText);
                if (data.success) {
                    showToast(data.message || '<?= $escaper->escapeJs(__('Subscribed!')) ?>', 'success');
                    formEl.style.display = 'none';
                    subscribedEl.style.display = '';
                    setTrigger(true);
                } else {
                    showToast(data.message || '<?= $escaper->escapeJs(__('Failed')) ?>', 'error');
                }
            } catch(ex) { showToast('<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error'); }
            btn.disabled = false;
            btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Notify Me When Available')) ?>';
        };
        xhr.onerror = function() {
            showToast('<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error');
            btn.disabled = false;
            btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Notify Me When Available')) ?>';
        };
        xhr.send(fd);
    });

    if (unsubBtn) {
        unsubBtn.addEventListener('click', function() {
            var fd = new FormData();
            fd.append('product_id', productId);
            fd.append('form_key', getFormKey());
            if (!isLoggedIn) {
                var unsubEmail = document.getElementById(uid + '-email');
                if (unsubEmail) fd.append('email', unsubEmail.value);
            }
            unsubBtn.textContent = '<?= $escaper->escapeJs(__('Removing...')) ?>';
            unsubBtn.disabled = true;

            var xhr = new XMLHttpRequest();
            xhr.open('POST', '<?= $escaper->escapeJs($block->getUnsubscribeUrl()) ?>');
            xhr.withCredentials = true;
            xhr.onload = function() {
                var data = {};
                try { data = JSON.parse(xhr.responseText); } catch(ex) {}
                if (data.success) {
                    subscribedEl.style.display = 'none';
                    formEl.style.display = '';
                    setTrigger(false);
                    showToast('<?= $escaper->escapeJs(__('Unsubscribed')) ?>', 'success');
                } else {
                    showToast(data.message || '<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error');
                }
                unsubBtn.textContent = '<?= $escaper->escapeJs(__('Remove')) ?>';
                unsubBtn.disabled = false;
            };
            xhr.onerror = function() {
                showToast('<?= $escaper->escapeJs(__('An error occurred.')) ?>', 'error');
                unsubBtn.textContent = '<?= $escaper->escapeJs(__('Remove')) ?>';
                unsubBtn.disabled = false;
            };
            xhr.send(fd);
        });
    }
});
</script>
