<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="panth_lowstocknotification_send_heartbeat" instance="Panth\LowStockNotification\Cron\SendHeartbeat" method="execute">
            <schedule>39 4 * * *</schedule>
        </job>
        <job name="lowstocknotification_stock_alert" instance="Panth\LowStockNotification\Cron\StockAlertNotification" method="execute">
            <schedule>0 */6 * * *</schedule>
        </job>
        <!-- Daily heartbeat - conditional inside Cron\SendHeartbeat. -->
    </group>
</config>
